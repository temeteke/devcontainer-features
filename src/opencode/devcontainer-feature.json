{
  "id": "opencode",
  "version": "0.4.0",
  "name": "OpenCode",
  "description": "Installs OpenCode 2 CLI, VS Code extension, and persists its config, data, and shared agent directories.",
  "options": {
    "install": {
      "type": "boolean",
      "default": true,
      "description": "Install the tool."
    },
    "persist": {
      "type": "boolean",
      "default": true,
      "description": "Persist configuration/auth/state by linking the tool's expected directory to the host home directory."
    },
    "cache": {
      "type": "boolean",
      "default": true,
      "description": "Share the OpenCode plugin cache (npm) through a Docker volume to speed up startup across containers."
    },
    "warmup": {
      "type": "boolean",
      "default": true,
      "description": "Wait for the OpenCode service and plugins to become ready during postCreate/postStart."
    },
    "version": {
      "type": "string",
      "default": "latest",
      "description": "npm package version for @opencode/cli. Use latest or a concrete version."
    }
  },
  "dependsOn": {
    "ghcr.io/temeteke/devcontainer-features/agents:0": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "containerEnv": {
    "OPENCODE_CONFIG_DIR": "/mnt/devcontainer-features/opencode/config"
  },
  "mounts": [
    {
      "type": "bind",
      "source": "${localEnv:HOME}/.config/opencode",
      "target": "/mnt/devcontainer-features/opencode/config"
    },
    {
      "type": "bind",
      "source": "${localEnv:HOME}/.local/share/opencode",
      "target": "/mnt/devcontainer-features/opencode/data"
    },
    {
      "type": "volume",
      "source": "devcontainer-opencode-npm-cache",
      "target": "/mnt/devcontainer-features/opencode/cache"
    }
  ],
  "postCreateCommand": "/usr/local/share/devcontainer-features/opencode/setup-persistence.sh",
  "postStartCommand": "/usr/local/share/devcontainer-features/opencode/warmup.sh",
  "customizations": {
    "vscode": {
      "extensions": ["sst-dev.opencode"]
    }
  }
}
