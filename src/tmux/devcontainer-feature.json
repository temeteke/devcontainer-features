{
  "id": "tmux",
  "version": "0.1.0",
  "name": "tmux",
  "description": "Installs tmux and makes the host ~/.config/tmux configuration available read-only.",
  "mounts": [
    {
      "type": "bind",
      "source": "${localEnv:HOME}/.config/tmux",
      "target": "/mnt/devcontainer-features/tmux/config",
      "readonly": true
    }
  ],
  "postCreateCommand": "/usr/local/share/devcontainer-features/tmux/setup-persistence.sh"
}
