{
  "id": "vim",
  "version": "0.1.0",
  "name": "Vim",
  "description": "Installs vim and makes the host ~/.vim configuration available read-only.",
  "mounts": [
    {
      "type": "bind",
      "source": "${localEnv:HOME}/.vim",
      "target": "/mnt/devcontainer-features/vim/config",
      "readonly": true
    }
  ],
  "postCreateCommand": "/usr/local/share/devcontainer-features/vim/setup-persistence.sh"
}
